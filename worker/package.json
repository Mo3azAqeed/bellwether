{
  "name": "bellwether-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply bellwether --local",
    "db:migrate:remote": "wrangler d1 migrations apply bellwether --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:sql": "node scripts/generate-seed-sql.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
